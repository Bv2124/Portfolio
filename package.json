    "budget": "node scripts/check-budget.mjs",
    "og": "node scripts/og-image.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "shots:projects": "node scripts/project-shots.mjs",
    "lcp": "node scripts/measure-lcp.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.71.0",
    "next": "^15.5.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "serve": "^14.2.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9",
    "vitest": "^5.1.1"
  },
  "overrides": {
